---
import Root from '@components/layout/Root.astro'
import Placeholder from '@components/ui/Placeholder.astro'

const code = '500'
const description = '服务器出错'
---

<Root
  name={code}
  description={description}
  color="#feec44"
  favicon="/favicon.svg"
>
  <Placeholder code={code} description={description} />
</Root>
