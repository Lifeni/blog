---
import Root from '@components/layout/Root.astro'
import Placeholder from '@components/ui/Placeholder.astro'

const code = 'Todo'
const description = '代码可行'
const warning = ['「代码可行」正在开发中', 'This page is under development']
---

<Root
  name="代码可行"
  description="这里有一些做过的开源项目。"
  color="#f75248"
  favicon="/dev/favicon.svg"
>
  <Placeholder code={code} description={description} warning={warning} />
</Root>
