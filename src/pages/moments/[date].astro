---
import PageInfo from '@components/notebook/article/PageInfo.astro'
import Layout from '@components/notebook/Layout.astro'
import MomentLink from '@components/notebook/moment/MomentLink.astro'
import MomentPhoto from '@components/notebook/moment/MomentPhoto.astro'
import { Icon } from 'astro-icon/components'
import { getCollection, render } from 'astro:content'
import dayjs from 'dayjs'

export async function getStaticPaths() {
  const moments = await getCollection('时刻')
  return moments.map(moment => ({
    params: { date: dayjs(moment.data.date).format('YYYY-MM-DD') },
    props: { moment },
  }))
}

const { moment } = Astro.props
const { Content, headings } = await render(moment)

const moments = await getCollection('时刻')
const yearMoments = moments
  .map(moment => moment.data)
  .sort((a, b) => dayjs(a.date).unix() - dayjs(b.date).unix())
  .filter(
    target =>
      dayjs(moment.data.date).isSame(dayjs(target.date), 'year') &&
      target.name !== moment.data.name,
  )
---

<Layout
  name={dayjs(moment.data.date).format('YYYY-MM-DD')}
  description={`${moment.data.name}，${moment.data.location}`}
>
  <MomentPhoto {...moment.data} />
  <section class:list={['w-full', 'mx-auto px-0', 'flex flex-col gap-4']}>
    <div
      class:list={[
        'flex flex-col justify-center items-center gap-1',
        'px-4 py-2',
        'text-sm text-center text-neutral-500 dark:text-neutral-400',
      ]}
    >
      <span class:list={['flex', 'whitespace-nowrap']}>
        {
          yearMoments.length > 0 ? (
            <Fragment>
              {dayjs(moment.data.date).year()} 年还有 {yearMoments.length}
              个时刻
            </Fragment>
          ) : (
            <Fragment>
              没有更多 {dayjs(moment.data.date).year()} 年的时刻
            </Fragment>
          )
        }
      </span>
      <Icon
        aria-hidden="true"
        name={yearMoments.length > 0
          ? 'ri:arrow-down-double-line'
          : 'ri:camera-4-line'}
        class:list={['w-4 h-4']}
      />
    </div>

    {
      yearMoments.length > 0 && (
        <ul
          class:list={[
            'w-auto max-w-full',
            'mx-auto my-0 p-0',
            'flex items-center gap-4',
            'overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden',
          ]}
        >
          {yearMoments.map(moment => (
            <li class:list={['w-full', 'list-none']}>
              <MomentLink
                href={`/moments/${dayjs(moment.date).format('YYYY-MM-DD')}`}
                cover={{
                  path: moment.path,
                  description: moment.name,
                }}
                name={moment.name}
                code={dayjs(moment.date).format('YYYY 年 MM 月 DD 日')}
                class:list={['!w-auto !h-60 sm:!h-72']}
              />
            </li>
          ))}
        </ul>
      )
    }
  </section>
  <PageInfo slot="[+]" text={`「 ${moment.data.name} 」`} />
</Layout>
