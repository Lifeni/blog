---
import ArticleLink from '@components/notebook/article/ArticleLink.astro'
import PageInfo from '@components/notebook/article/PageInfo.astro'
import Layout from '@components/notebook/Layout.astro'
import { getCollection } from 'astro:content'
import dayjs from 'dayjs'

const articles = await getCollection('文章')

const filteredArticles = articles
  .map(article => article.data)
  .filter(
    article => article.featured && (import.meta.env.DEV || !article.draft),
  )
  .sort((a, b) => dayjs(b.date.created).unix() - dayjs(a.date.created).unix())

const pinnedArticles = filteredArticles.filter(article => article.pinned)
const unpinnedArticles = filteredArticles.filter(article => !article.pinned)
const allArticles = [...pinnedArticles, ...unpinnedArticles]
---

<Layout>
  <ul
    class:list={[
      'z-1',
      'w-full max-w-144',
      'mx-auto my-0 p-0',
      'flex flex-col gap-4 flex-1 items-center justify-center',
      'list-none',
    ]}
  >
    {
      allArticles.map(article => (
        <li class:list={['w-full', 'list-none']}>
          <ArticleLink article={article} />
        </li>
      ))
    }
  </ul>
  <PageInfo slot="[+]" text="近期文章" code={allArticles.length} />
</Layout>
