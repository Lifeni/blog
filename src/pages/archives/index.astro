---
import Layout from '@components/notebook/Layout.astro'
import PageInfo from '@components/notebook/article/PageInfo.astro'
import Divider from '@components/ui/Divider.astro'
import Spacer from '@components/ui/Spacer.astro'
import { frontmatterFormat, groupArticlesByYear } from '@libs/utils'
import { Icon } from 'astro-icon/components'
import { getCollection } from 'astro:content'
import dayjs from 'dayjs'

const articles = await getCollection('文章')
const archives = await getCollection('存档')

const formattedArchives = archives.map(({ data }) => frontmatterFormat(data))
const allArticles = [
  ...articles.map(item => item.data),
  ...formattedArchives,
].filter(article => import.meta.env.DEV || !article.draft)

const groupedArticles = groupArticlesByYear(allArticles)
---

<Layout name="存档">
  {
    groupedArticles.map(group => (
      <section
        class:list={[
          'z-1',
          'w-full max-w-144',
          'mx-auto px-0 py-4',
          'flex flex-col gap-4',
          'bg-white dark:bg-neutral-850',
          'rounded-2xl',
        ]}
      >
        <h2 class:list={['m-0 px-5', 'font-mono text-xl']}>{group.year}</h2>
        <ul class:list={['w-full', 'm-0 p-0', 'flex flex-col']}>
          {group.articles.map((article, index) => (
            <>
              <li class:list={['w-full', 'list-none']}>
                <a
                  href={`/${article.archived ? 'archives' : 'articles'}/${article.id}`}
                  class:list={[
                    'group',
                    'w-full',
                    'px-5 py-1.5',
                    'flex items-center justify-between gap-4',
                    'text-neutral-950 dark:text-neutral-100',
                    'bg-transparent hover:bg-neutral-100 dark:hover:bg-neutral-750',
                    'focus-visible:outline-yellow-500 dark:focus-visible:outline-yellow-400 focus-visible:outline-4 focus-visible:outline-offset-1',
                    'no-underline',
                    'overflow-hidden',
                    'transition-all',
                  ]}
                >
                  <time
                    class:list={[
                      'text-neutral-500 dark:text-neutral-400 font-mono',
                    ]}
                  >
                    {dayjs(article.date.created).format('MM/DD')}
                  </time>

                  <h3
                    class:list={[
                      'w-fit',
                      'm-0',
                      'font-medium text-base',
                      'truncate',
                    ]}
                  >
                    {article.name}
                  </h3>

                  {article.subtitle && (
                    <span
                      class:list={[
                        'font-normal leading-[1.625] text-neutral-500 dark:text-neutral-400',
                        'truncate',
                      ]}
                    >
                      {article.subtitle}
                    </span>
                  )}

                  <Spacer />

                  {article.draft && (
                    <Icon
                      aria-label="未完成"
                      name="ri:quill-pen-fill"
                      title="未完成"
                      class:list={[
                        'hidden sm:block',
                        'w-4.5 h-4.5 min-w-4.5',
                        'mx-1',
                        'text-neutral-300 dark:text-neutral-500 group-hover:text-neutral-500 dark:group-hover:text-neutral-300',
                        'transition-all',
                      ]}
                    />
                  )}

                  {article.archived && (
                    <Icon
                      aria-label="已存档"
                      name="ri:archive-2-fill"
                      title="已存档"
                      class:list={[
                        'hidden sm:block',
                        'w-4.5 h-4.5 min-w-4.5',
                        'mx-1',
                        'text-neutral-300 dark:text-neutral-500 group-hover:text-neutral-500 dark:group-hover:text-neutral-300',
                        'transition-all',
                      ]}
                    />
                  )}
                </a>
              </li>
              {(index + 1) % 5 === 0 && index !== group.articles.length - 1 && (
                <li class:list={['w-full', 'my-4 px-5', 'flex', 'list-none']}>
                  <Divider />
                </li>
              )}
            </>
          ))}
        </ul>
      </section>
    ))
  }
  <PageInfo slot="[+]" text="所有文章" code={allArticles.length} />
</Layout>
