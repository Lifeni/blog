---
import ArticleContent from '@components/notebook/article/ArticleContent.astro'
import TableOfContents from '@components/notebook/article/TableOfContents.astro'
import Layout from '@components/notebook/Layout.astro'
import Img from '@components/ui/markdown/media/Img.astro'
import { frontmatterFormat } from '@libs/utils'
import { getCollection, render } from 'astro:content'
import dayjs from 'dayjs'
import 'dayjs/locale/zh-cn'
import relativeTime from 'dayjs/plugin/relativeTime'

dayjs.extend(relativeTime)
dayjs.locale('zh-cn')

export async function getStaticPaths() {
  const archives = await getCollection('存档')
  return archives.map(archive => ({
    params: { id: archive.data.name },
    props: { archive },
  }))
}

const { archive } = Astro.props
const { Content, headings } = await render(archive)
---

<Layout name={archive.data.title} description={archive.data.description}>
  <ArticleContent
    {...frontmatterFormat(archive.data)}
    id={headings[0].slug}
    content={Content}
    message={`本文编写于 ${dayjs(archive.data.date).fromNow()}，内容可能过时`}
    icon="ri:folder-open-fill"
    headings={headings}
    components={{ img: Img }}
  />
  {headings && <TableOfContents slot="[+]" headings={headings} />}
</Layout>
