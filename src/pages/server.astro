---
import Root from '@components/layout/Root.astro'
import Placeholder from '@components/ui/Placeholder.astro'

const code = 'Todo'
const description = '越过长城'
const warning = ['「越过长城」正在开发中', 'This page is under development']
---

<Root
  name="越过长城"
  description="Across the Great Wall we can reach every corner of the world."
  color="#40d583"
  favicon="/server/favicon.svg"
>
  <Placeholder code={code} description={description} warning={warning} />
</Root>
