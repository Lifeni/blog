---
import ImageCard from '@components/notebook/story/ImageCard.astro'
import Spacer from '@components/ui/Spacer.astro'
import { frontmatterFormat } from '@libs/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import dayjs from 'dayjs'
import 'dayjs/locale/zh-cn'
import relativeTime from 'dayjs/plugin/relativeTime'
import type { Story } from 'src/content'

dayjs.extend(relativeTime)
dayjs.locale('zh-cn')

interface Props {
  story: Story
}

const { story } = Astro.props

const articles = await getCollection('文章')
const archives = await getCollection('存档')

const storyArticles = articles
  .filter(article => story.articles?.includes(article.data.id))
  .map(article => article.data)

const storyArchives = archives
  .filter(archive => story.articles?.includes(archive.data.name))
  .map(archive => frontmatterFormat(archive.data))

const allArticles = [...storyArticles, ...storyArchives]
  .filter(article => import.meta.env.DEV || !article.draft)
  .sort((a, b) => dayjs(b.date.created).unix() - dayjs(a.date.created).unix())
  .filter(article => article.cover)
  .slice(0, 4)
---

<li
  class:list={[
    'w-full',
    'grid grid-cols-1 sm:grid-cols-2 gap-4',
    'list-none break-inside-avoid',
  ]}
>
  <ImageCard
    href={`/stories/${story.id}`}
    cover={{
      path: story.cover!.path,
      description: story.cover!.description,
    }}
    name={`# ${story.name}`}
    code={`×${allArticles.length || 0}`}
    class:list={['aspect-1/1']}
  />

  {
    allArticles.length !== 0 && (
      <div class:list={['grid grid-cols-2 gap-4']}>
        {allArticles.map(article => (
          <ImageCard
            href={`/articles/${article.id}`}
            cover={{
              path: article.cover!.path,
              description: article.cover!.description,
            }}
            class:list={['aspect-1/1']}
          />
        ))}
      </div>
    )
  }
</li>
