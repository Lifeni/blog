---
import PageInfo from '@components/notebook/article/PageInfo.astro'
import Popover from '@components/layout/Popover.astro'
import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
const list = headings.filter(
  heading => heading.depth === 2 || heading.depth === 3,
)
---

{
  list.length > 0 ? (
    <Popover>
      <button
        slot="@"
        title="目录"
        class:list={[
          'relative group',
          'max-w-[calc(100dvw-(--spacing(44)))] sm:max-w-unset sm:max-h-[calc(100dvh-(--spacing(44)))]',
          'p-3',
          'flex sm:flex-col items-center justify-start gap-4',
          'bg-transparent group-hover:bg-neutral-200 dark:group-hover:bg-neutral-850',
          'rounded-full',
          'border-none cursor-pointer',
          'focus-visible:outline-yellow-500 dark:focus-visible:outline-yellow-400 focus-visible:outline-4 focus-visible:outline-offset-1',
          'overflow-hidden',
          'transition-all',
        ]}
      >
        {list.map(heading => (
          <span
            class:list={[
              heading.depth === 2
                ? 'w-2 h-2 min-w-2 min-h-2'
                : 'w-1 h-1 min-w-1 min-h-1',
              'flex',
              'rounded-full',
              'bg-neutral-300 dark:bg-neutral-500 group-hover:bg-neutral-500 dark:group-hover:bg-neutral-300',
              'transition-colors',
            ]}
          />
        ))}
        <div
          class:list={[
            'absolute right-0 bottom-0',
            'w-3 h-full sm:w-full sm:h-3',
            'bg-gradient-to-l sm:bg-gradient-to-t from-white group-hover:from-neutral-200 to-transparent dark:from-neutral-800 sm:dark:from-neutral-900 dark:group-hover:from-neutral-850',
            'pointer-events-none transition-all',
          ]}
        />
      </button>

      <ul
        slot="<#>"
        class:list={[
          'w-full h-full max-h-[calc(100dvh-(--spacing(24)))]',
          'm-0 px-0 py-3',
          'flex flex-col',
          'list-none',
          'overflow-y-auto',
        ]}
      >
        {list.map(heading => (
          <li class:list={['w-full', 'flex items-center gap-2']}>
            <a
              href={`#${heading.slug}`}
              class:list={[
                'w-full',
                'flex',
                'px-5 py-1.5',
                'text-sm text-neutral-500 hover:text-neutral-600 dark:text-neutral-400 dark:hover:text-neutral-300',
                'bg-transparent hover:bg-neutral-100 dark:hover:bg-neutral-750',
                'focus-visible:outline-yellow-500 dark:focus-visible:outline-yellow-400 focus-visible:outline-4 focus-visible:outline-offset-1',
                'no-underline',
                'overflow-hidden',
                'transition-all',
                heading.depth === 2 ? 'font-bold' : 'pl-8 font-normal',
              ]}
            >
              <span class:list={['w-full min-w-0', 'flex-1', 'truncate']}>
                {heading.text}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Popover>
  ) : (
    <PageInfo text="没有目录" code=":)" />
  )
}
