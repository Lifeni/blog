---
import dayjs from 'dayjs'
import type { Moment } from 'src/content'
import ImageCard from '../story/ImageCard.astro'

interface Props {
  moment: Moment
  class?: string
}

const { moment, class: className } = Astro.props
---

<li class:list={['w-full', 'mb-4', 'list-none']}>
  <ImageCard
    href={`/moments/${dayjs(moment.date).format('YYYY-MM-DD')}`}
    cover={{
      path: moment.path,
      description: moment.name,
    }}
    name={moment.name}
    code={dayjs(moment.date).format('YYYY 年 MM 月 DD 日')}
  />
</li>
