---
import Divider from '@components/ui/Divider.astro'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import dayjs from 'dayjs'
import type { Moment } from '@src/content'

interface Props extends Moment {}
const { name, date, location, path, camera } = Astro.props

const isLandscape = path.width > path.height
---

<article
  class:list={[
    'relative',
    isLandscape
      ? 'w-[calc(100%+(--spacing(8)))] sm:w-fit'
      : 'w-[calc(100%+(--spacing(8)))] sm:w-full max-w-144',
    '-mx-4 sm:mx-auto p-4',
    'flex flex-col gap-4',
    'bg-white dark:bg-neutral-850',
    'rounded-4xl sm:rounded-2xl',
    'overflow-hidden',
  ]}
>
  <div
    class:list={[
      'flex justify-center',
      'bg-neutral-100 dark:bg-neutral-900',
      'rounded-2xl sm:rounded-md',
      'animate-fade-in',
      'overflow-hidden',
    ]}
  >
    <Image
      src={path}
      alt={name}
      title={name}
      loading="lazy"
      layout="full-width"
      class:list={[
        'medium-zoom',
        isLandscape
          ? 'w-fit max-w-full h-full max-h-[calc(100dvh-(--spacing(44)))] md:min-h-120'
          : 'w-full h-auto',
        'text-sm text-neutral-100 dark:text-neutral-900 leading-12',
        'bg-neutral-100 dark:bg-neutral-900',
      ]}
    />
  </div>
  <section
    class:list={[
      'w-full',
      'px-3 py-0.5',
      'flex items-center justify-between gap-x-3 gap-y-1 flex-wrap',
      'text-sm truncate text-neutral-500 dark:text-neutral-400',
    ]}
  >
    <div class:list={['flex items-center gap-x-3 gap-y-1 flex-wrap']}>
      <time class:list={['font-bold']}>
        {dayjs(date).format('YYYY 年 MM 月 DD 日')}
      </time>
      <Divider orientation="vertical" class:list={['h-3.5']} />
      <span>{location}</span>
    </div>

    <div class:list={['flex items-center gap-x-2 gap-y-1']}>
      由 <span class:list={['font-bold']}>{camera}</span> 拍摄
    </div>
  </section>
</article>
