---
import { links } from '@libs/configs'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<footer
  class:list={[
    'flex justify-between items-center flex-wrap',
    'overflow-hidden',
    className,
  ]}
>
  {
    links.map(section => (
      <section class:list={['flex items-center flex-wrap']}>
        {section.map(link => (
          <a
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : '_self'}
            rel={
              link.href.startsWith('http') ? 'nofollow noopener noreferrer' : ''
            }
            class:list={[
              'px-2.5 py-1.25 sm:px-3 sm:py-1.75',
              'text-sm text-neutral-500 hover:text-neutral-600 dark:text-neutral-400 dark:hover:text-neutral-300',
              'truncate',
              'no-underline',
              'bg-transparent hover:bg-neutral-200 dark:hover:bg-neutral-850',
              'focus-visible:outline-yellow-500 dark:focus-visible:outline-yellow-400 focus-visible:outline-4 focus-visible:outline-offset-2',
              'rounded-full',
              'transition-all',
            ]}
          >
            {link.name}
          </a>
        ))}
      </section>
    ))
  }
</footer>
