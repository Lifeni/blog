---
import { Icon } from 'astro-icon/components'

export type NavBarLinkProps = {
  name: string
  icon: string | string[]
  href?: string
  isActive?: boolean
}

interface Props extends NavBarLinkProps {}
const { name, href, icon, isActive } = Astro.props

const Element = href ? 'a' : 'button'
---

<Element
  href={href}
  target={href ? (href.startsWith('http') ? '_blank' : '_self') : ''}
  rel={href
    ? href.startsWith('http')
      ? 'nofollow noopener noreferrer'
      : ''
    : ''}
  title={name}
  class:list={[
    'group flex items-center justify-center gap-2.5',
    'p-3',
    'border-none',
    'bg-transparent hover:bg-neutral-200 dark:hover:bg-neutral-850',
    'whitespace-nowrap',
    'cursor-pointer no-underline',
    'rounded-full',
    'focus-visible:outline-yellow-500 dark:focus-visible:outline-yellow-400 focus-visible:outline-4 focus-visible:outline-offset-1',
    'transition-all',
    isActive
      ? 'text-neutral-950 dark:text-neutral-100'
      : 'text-neutral-300 dark:text-neutral-500 hover:text-neutral-500 dark:hover:text-neutral-300',
  ]}
>
  <Icon
    aria-label={name}
    name={Array.isArray(icon) ? (isActive ? icon[1] : icon[0]) : icon}
    class:list={['w-5 h-5']}
  />
  <span class:list={['sr-only', 'text-neutral-950 dark:text-neutral-100']}>
    {name}
  </span>
</Element>
